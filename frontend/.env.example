# Base Sepolia deployment. These are public addresses, not secrets.
NEXT_PUBLIC_MENTALIST_ADDRESS=0xCF72B6D36619861521BF1b04f3A64e3647aE9356
NEXT_PUBLIC_MARKET_ADDRESS=0x8b1508f518e4a04961c5f57ad6734304574f05f7

# "testnet" or "mainnet". Only affects which chain the wallet connector offers.
NEXT_PUBLIC_NETWORK=testnet

# Optional. Without it the wallet list falls back to injected connectors only, which is
# enough to play with MetaMask. Get one at https://cloud.walletconnect.com to add the rest.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
