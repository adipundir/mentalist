# Base Mainnet (fill in for mainnet deployment)
PRIVATE_KEY_BASE=
BASE_RPC_URL=https://mainnet.base.org

# Base Sepolia (fill in for testnet deployment)
PRIVATE_KEY_BASE_SEPOLIA=
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
KEEPER_ADDRESS=

# Local-only answer ids used by scripts/deploy.ts to open cases.
# Do not commit real values. Example shape only:
# MENTALIST_ANSWER_IDS=[0,1,2,3,4,0,1]
MENTALIST_ANSWER_IDS=

# Optional comma-separated per-case windows in seconds. Falls back to MENTALIST_OPEN_FOR.
MENTALIST_OPEN_FOR=1800
MENTALIST_WINDOWS=

# Local Anvil (these are the well-known default anvil keys — safe for local dev only!)
PRIVATE_KEY_ANVIL=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
ANVIL_RPC_URL=http://127.0.0.1:8545
SEED_PHRASE=test test test test test test test test test test test junk
