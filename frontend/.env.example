# Deployed addresses — set after `pnpm --filter contracts deploy:testnet`.
# Leave blank and /case/play explains what's missing; /case/demo works regardless.
NEXT_PUBLIC_MENTALIST_ADDRESS=
NEXT_PUBLIC_REWARDS_ADDRESS=

# testnet (Base Sepolia, default) | mainnet (Base)
NEXT_PUBLIC_NETWORK=testnet

# Optional: enables WalletConnect/mobile wallets in RainbowKit.
# Without it, injected wallets still work. https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
