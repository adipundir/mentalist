# Base Sepolia deployment. These are public addresses, not secrets.
#
# Mentalist is the whole game: it holds the encrypted answer per case, takes encrypted bets
# against it, and pays the winners in Megapot tickets. Nothing else is read from the chain.
# "testnet" or "mainnet". Switches the chain the wallet connects to, the Inco Lightning
# instance, the USDC address, and the explorer every receipt links to. There is no mainnet
# deployment, so this is testnet in practice.
NEXT_PUBLIC_NETWORK=testnet

# Optional. Without it the wallet list falls back to injected connectors only, which is
# enough to play with MetaMask. Get one at https://cloud.walletconnect.com to add the rest.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Server-only. Required on Vercel for the keeper and post-settlement reveal.
KEEPER_PRIVATE_KEY=
KEEPER_SECRET=
MENTALIST_ANSWERS=
